{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "warehouse", "sources", "pipeline", "services", "analysisTemplates"],
  "properties": {
    "nameOverride": {"type":"string"}, "fullnameOverride": {"type":"string"},
    "global": {"$ref":"#/definitions/global"},
    "warehouse": {"type":"object","required":["name","interval","freightCreationPolicy"],"additionalProperties":false,"properties":{"name":{"$ref":"#/definitions/name"},"interval":{"type":"string","minLength":1},"freightCreationPolicy":{"enum":["Automatic","Manual"]}}},
    "sources": {"type":"object","required":["components","chartGit"],"additionalProperties":false,"properties":{"componentDefaults":{"type":"object","additionalProperties":true},"components":{"type":"array","items":{"$ref":"#/definitions/component"}},"chartGit":{"$ref":"#/definitions/chartGit"}}},
    "pipeline": {"type":"object","required":["stages"],"additionalProperties":false,"properties":{"notifications":{"type":"object","additionalProperties":true},"stages":{"type":"object","additionalProperties":false,"required":["prepareRelease","dev","integration","preProduction","production"],"properties":{"prepareRelease":{"$ref":"#/definitions/stage"},"dev":{"$ref":"#/definitions/stage"},"integration":{"$ref":"#/definitions/stage"},"preProduction":{"$ref":"#/definitions/stage"},"production":{"$ref":"#/definitions/stage"}}}}},
    "services": {"type":"object","additionalProperties":false,"properties":{"prometheus":{"$ref":"#/definitions/service"},"elasticsearch":{"$ref":"#/definitions/service"},"ai":{"$ref":"#/definitions/service"},"serviceNow":{"$ref":"#/definitions/service"},"gitLab":{"$ref":"#/definitions/service"},"mail":{"$ref":"#/definitions/service"},"monitoring":{"$ref":"#/definitions/service"}}},
    "analysisTemplates": {"type":"array","items":{"$ref":"#/definitions/analysis"}}
  },
  "definitions": {
    "global": {
      "type": "object",
      "required": ["system", "dispatcher"],
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "object",
          "required": ["name", "displayName", "owner"],
          "additionalProperties": false,
          "properties": {
            "name": {"type":"string","minLength":1},
            "displayName": {"type":"string","minLength":1},
            "owner": {"type":"string","minLength":1}
          }
        },
        "labels": {"type":"object","additionalProperties":{"type":"string"}},
        "annotations": {"type":"object","additionalProperties":{"type":"string"}},
        "dispatcher": {
          "type": "object",
          "required": ["image"],
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "object",
              "required": ["repository", "tag", "pullPolicy"],
              "additionalProperties": false,
              "properties": {
                "repository": {"type":"string"},
                "tag": {"type":"string"},
                "pullPolicy": {"enum":["Always","IfNotPresent","Never"]}
              }
            }
          }
        }
      }
    },
    "name":{"type":"string","minLength":1,"maxLength":63},
    "repo":{"type":"object","required":["url"],"additionalProperties":false,"properties":{"url":{"type":"string","minLength":1},"username":{"type":"string"},"password":{"type":"string"}}},
    "tagPolicy":{"type":"object","additionalProperties":false,"properties":{"allowedPatterns":{"type":"array","items":{"type":"string"}},"deniedPatterns":{"type":"array","items":{"type":"string"}}}},
    "component":{"type":"object","required":["name","image","developerGit","releaseConfiguration","valuesMapping"],"additionalProperties":false,"properties":{"name":{"$ref":"#/definitions/name"},"enabled":{"type":"boolean"},"image":{"type":"object","required":["repository"],"additionalProperties":true,"properties":{"repository":{"type":"string","minLength":1}}},"developerGit":{"type":"object","required":["repository"],"additionalProperties":false,"properties":{"repository":{"$ref":"#/definitions/repo"}}},"qaGit":{"type":"object","additionalProperties":false,"properties":{"repository":{"$ref":"#/definitions/repo"},"branch":{"type":"string"},"path":{"type":"string"}}},"releaseConfiguration":{"type":"object","required":["generationEnabled","outputPath"],"additionalProperties":false,"properties":{"generationEnabled":{"type":"boolean"},"devConfigurationPath":{"type":"string"},"chartOverlayPath":{"type":"string"},"outputPath":{"type":"string","minLength":1}}},"valuesMapping":{"type":"object","required":["tagPath"],"additionalProperties":false,"properties":{"tagPath":{"type":"string","minLength":1,"pattern":"^[^{}]+$"}}},"tagPolicy":{"$ref":"#/definitions/tagPolicy"},"verification":{"type":"object","additionalProperties":true}}},
    "chartGit":{"type":"object","required":["repository","branches","subscription"],"additionalProperties":false,"properties":{"repository":{"$ref":"#/definitions/repo"},"branches":{"type":"object","required":["source","production"],"additionalProperties":false,"properties":{"source":{"type":"string","minLength":1},"production":{"type":"string","minLength":1}}},"subscription":{"type":"object","required":["enabled"],"additionalProperties":true,"properties":{"enabled":{"type":"boolean"}}}}},
    "stage":{"type":"object","required":["name","autoPromotionEnabled"],"additionalProperties":true,"properties":{"name":{"$ref":"#/definitions/name"},"autoPromotionEnabled":{"type":"boolean"},"freightSelectionPolicy":{"enum":["NewestFreight","MatchUpstream"]},"tagPolicy":{"$ref":"#/definitions/tagPolicy"}}},
    "auth":{"type":"object","required":["type"],"additionalProperties":false,"properties":{"type":{"enum":["none","basic","apiKey"]},"username":{"type":"string"},"password":{"type":"string"},"headerName":{"type":"string"},"key":{"type":"string"},"prefix":{"type":"string"}}},
    "service":{"type":"object","additionalProperties":true,"properties":{"endpoint":{"type":"string"},"allowInsecureHttp":{"type":"boolean"},"authentication":{"$ref":"#/definitions/auth"}}},
    "analysis":{"type":"object","required":["name","type","target","retryAmount","timeout","ttlAfterFinished","mode"],"additionalProperties":true,"properties":{"name":{"$ref":"#/definitions/name"},"type":{"enum":["smooth","job","prometheus","http","elasticsearch","external"]},"target":{"enum":["components","stage"]},"retryAmount":{"type":"integer","minimum":0},"timeout":{"type":"string"},"ttlAfterFinished":{"type":"string"},"mode":{"enum":["blocking","dry-run"]}}}
  }
}
